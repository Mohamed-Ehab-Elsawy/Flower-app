#!/bin/bash

# --- تعريف الألوان والرموز ---
CHECKMARK="\033[0;32m✅\033[0m"
CROSSMARK="\033[0;31m❌\033[0m"
PROGRESS="\033[0;34m🔵\033[0m"
TITLE="\033[1;36m" # Cyan Bold
YELLOW="\033[1;33m"
NC="\033[0m" # No Color

echo -e "\n${TITLE}🚀 Starting Dart Linting Check...${NC}"
echo -e "------------------------------------------"

# 1. Install dependencies
echo -ne "${PROGRESS} Step 1: Fetching dependencies... "
if flutter pub get > /dev/null 2>&1; then
    echo -e "${CHECKMARK} Done"
else
    echo -e "${CROSSMARK} ${YELLOW}Failed!${NC}"
    exit 1
fi

# 2. Run build_runner
echo -ne "${PROGRESS} Step 2: Running build_runner... "
if dart run build_runner build --delete-conflicting-outputs > /dev/null 2>&1; then
    echo -e "${CHECKMARK} Done"
else
    echo -e "${CROSSMARK} ${YELLOW}Error in generation!${NC}"
    exit 1
fi

# 3. Check Formatting
echo -ne "${PROGRESS} Step 3: Checking formatting... "
if dart format --output=none --set-exit-if-changed . > /dev/null 2>&1; then
    echo -e "${CHECKMARK} Done"
else
    echo -e "${CROSSMARK} ${YELLOW}Formatting issues found!${NC}"
    echo -e "   👉 Run: ${YELLOW}dart format .${NC} to fix them."
    exit 1
fi

# 4. Static Analysis
echo -ne "${PROGRESS} Step 4: Running flutter analyze... "
if flutter analyze > /dev/null 2>&1; then
    echo -e "${CHECKMARK} Done"
else
    echo -e "${CROSSMARK} ${YELLOW}Linting errors found!${NC}"
    echo -e "   👉 Run ${YELLOW}flutter analyze${NC} to see the errors."
    exit 1
fi

echo -e "------------------------------------------"
echo -e "${CHECKMARK} ${TITLE}Awesome! Your code is clean. Committing now...${NC}\n"
exit 0