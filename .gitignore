pubspec.lock
# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# -------- Opinionated: Ignore generated code & env files (DO NOT COMMIT) --------
# Reason: Generated files are build artifacts and env files may contain secrets or
# local configuration. Keeping them out of VCS keeps the repo clean and secure.

# Generated Dart/Flutter outputs (e.g. build_runner, json_serializable, freezed)
**/*.g.dart
**/*.pb.dart
**/*.pb.*
**/generated/
generated_plugin_registrant.dart

# Environment files (local secrets / configs)
.env
.env.*
env/

# Local build outputs (redundant with /build/, kept for clarity)
**/build/

# Note: Keep the app's lockfile (pubspec.lock) committed for apps to ensure
# reproducible builds; don't ignore it unless this is a package.
# --------------------------------------------------------------------------------
